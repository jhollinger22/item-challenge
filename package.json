{
  "name": "item-challenge",
  "version": "1.0.0",
  "description": "Exam item management API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit && tsc --noEmit -p infrastructure",
    "synth": "cd infrastructure && cdk synth --quiet",
    "synth:prod": "cd infrastructure && cdk synth --quiet -c env=prod"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^20.14.9",
    "@vitest/ui": "^2.1.8",
    "aws-cdk": "^2.1142.0",
    "aws-cdk-lib": "^2.269.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  }
}
